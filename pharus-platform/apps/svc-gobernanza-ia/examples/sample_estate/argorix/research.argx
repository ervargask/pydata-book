module ClinicaInvestigacion

capability trace.write { level safe }
capability model.invoke { level restricted requires approval }

type Consulta { content: string }
type Resumen { content: string }

model ResumenModel {
    provider simulated
    capability model.invoke
    input Consulta
    output Resumen
}

agent InvestigacionAgent {
    security { approval granted }
    receives Consulta
    capabilities { trace.write model.invoke }
    models { ResumenModel }
    on Consulta as c { ask ResumenModel with c trace c }
}

passport InvestigacionPassport {
    agent InvestigacionAgent
    agent_name "Agente de investigación clínica"
    global_id "argx:agent:01AURORAINVEST"
    identity "did:argorix:aurora-investigacion-v1"
    provider "Unidad de Investigación"
    version "1.0.0"
    country "CL"
    jurisdiction "CL"
    data_residency ["CL"]
    model "simulated"
    risk_level "medium"
    data_scope ["internal", "salud-anonimizada"]
    intent "investigacion"
    intended_use ["resumen-literatura"]
    prohibited_use ["external-execution", "reidentificacion"]
    attestations ["policy-check", "evidence-bundle"]
}

policy InvestigacionGovernance {
    require agent_passport_declared
    require agent_identity_declared
    on violation {
        action review
        trace required
    }
}
